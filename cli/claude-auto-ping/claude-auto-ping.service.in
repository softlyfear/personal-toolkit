[Unit]
Description=Claude Code auto-ping — opens the 5-hour session window on a schedule (MSK)

[Service]
# claude and uv may live outside a user unit's default PATH
Environment=__PATH_ENV__
WorkingDirectory=__DIR__
ExecStart=__UV__ run main.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
